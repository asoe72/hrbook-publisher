<!DOCTYPE html:5>
<html>
<head>
    <title>book cover front</title>
    <meta http-equiv=Content-Type content="text/html; charset=utf-8">
    <link href="../css/book.css" type=text/css rel=stylesheet >
</head>
<body>
	<div class="book-header-container">
		<div class="book-hd-logo-box">
			<% if (bookinfo.langCode == "ko") { %>
				<img style="width: 4.8cm" src="../view/image/hd_hyundai_robotics_ko.png">
			<% } else { %>
				<img style="width: 4.0cm" src="../view/image/hd_hyundai_robotics_en.png">
			<% } %>
		</div>
		<div class="book-manual-release-date"><%= bookinfo.manualReleaseDate %></div>
  </div>

	<hr class="book-header-line"/>

	<div class="book-series">
   	<%= bookinfo.series %>
    </div><br>
	<div class="book-title">
		<%= bookinfo.title %>
	</div><br>



	<div class="book-copyright">
		ⓒ Copyright 2024. HD Hyundai Robotics. All rights reserved.
	</div>

	<div id="bookinfo" style="display:none">
		<div id="info-series"><%= bookinfo.series %></div>
		<div id="info-title"><%= bookinfo.title %></div>
        <div id="info-publisher"><%= bookinfo.publisher %></div>
	</div>
</body>
</html>